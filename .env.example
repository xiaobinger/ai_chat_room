# ===== 数据库（MySQL 8.0+）=====
# 生产建议为应用创建专用最小权限账号，不要使用 root
DATABASE_URL="mysql://tianma:PASSWORD@127.0.0.1:3306/tianma_chat"

# ===== Redis（BullMQ 队列 + 房间事件 Pub/Sub，必需）=====
REDIS_URL="redis://127.0.0.1:6379"

# ===== 队列驱动 =====
# bullmq = 跨进程真实队列（API 与 Worker 分离部署时必须用这个）
# memory = 单进程内存队列（仅测试/CI；跨进程部署时任务会静默丢失）
QUEUE_DRIVER="bullmq"

# ===== 鉴权 =====
# 必须为高强度随机值。生成：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 未设置时 API 拒绝启动（失败关闭），不会静默降级为匿名访问
JWT_SECRET="REPLACE_WITH_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

# ===== 服务端口 =====
PORT=4000

# ===== CORS =====
# 生产经 nginx 同源反代时可留空；本地 vite dev(:3000) 直连 API(:4000) 时需填写
CORS_ORIGIN="http://localhost:3000"

# ===== 模型注册表（JSON 数组，必须写成单行）=====
# provider: mock | openai | anthropic | deepseek | custom
#   custom = 任意 OpenAI 兼容端点（POST {baseURL}/chat/completions）
# name 供 RoomRole.modelName 引用。"auto" 与 "default" 是保留别名，不能用作模型名。
#
# 解析语义（刻意失败关闭，不再静默回退 mock）：
#   - modelName 命中某个 name          -> 用它
#   - modelName 是 auto/空             -> 用 DEFAULT_MODEL
#   - 命中不了，或没配 DEFAULT_MODEL    -> 抛错，该角色进 error 态
#   - MODELS_CONFIG 不合契约或不是合法 JSON -> 进程启动即失败
# 想要离线可复现的行为，请显式把角色 modelName 设为 "mock"（mock 始终注册）。
#
# 注意：dotenv 不支持未加引号的多行值，务必保持单行。
DEFAULT_MODEL="auto-gateway"
MODELS_CONFIG='[{"name":"mock","provider":"mock","apiKey":""},{"name":"auto-gateway","provider":"custom","apiKey":"sk-REPLACE","baseURL":"http://127.0.0.1:5000/v1","model":"auto"}]'

# ===== 日志 =====
# debug | info | warn | error
LOG_LEVEL="info"

# ===== 运行环境 =====
NODE_ENV="development"

# ===== 前端（apps/web 构建时读取；仅 VITE_ 前缀会注入浏览器）=====
# 留空则默认 /api/v1，配合 nginx 同源反代
VITE_API_BASE=""

# ===== 演示数据（pnpm db:seed）=====
# 不设则用 owner@tianma.dev / tianma-demo。生产库上跑种子前请确认这两项已改掉。
SEED_EMAIL="owner@tianma.dev"
SEED_PASSWORD="tianma-demo"
